# Agent and optional API-backed web search use this OpenAI-compatible endpoint.
OPENAI_API_KEY="your_api_key_here"
OPENAI_BASE_URL="https://api.deepseek.com"
OPENAI_MODEL="deepseek-flash"

# Optional overrides when the agent or web search needs a different credential/model.
# AGENT_API_KEY="your_agent_api_key_here"
# AGENT_MODEL="deepseek-flash"
# WEB_SEARCH_MODEL="deepseek-flash"

# Optional search settings. The default provider tries the configured API and
# falls back to DuckDuckGo HTML if that provider is unavailable.
WEB_SEARCH_PROVIDER="auto"
WEB_SEARCH_FALLBACK=1

# Dataset location and metadata are configured in configs/dataset_config.yaml.
# Optional persistent directory for conversation history and analysis artifacts:
# OCEANMIND_RUNS_DIR=/path/to/oceanmind/agent_runs

# Required for the CARTO Light basemap in the interactive map.
CARTO_BASEMAP_API_KEY="your_carto_basemap_api_key_here"
