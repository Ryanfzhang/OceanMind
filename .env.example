# ============================================================================
# LLM API Keys
# ============================================================================
OPENAI_API_KEY="your_openai_compatible_api_key_here"
OPENAI_BASE_URL="https://api.deepseek.com"
OPENAI_MODEL="deepseek-v4-pro"
QUERY_ROUTER_MODEL="deepseek-v4-flash"
PLANNER_MODEL="deepseek-v4-pro"
PLANNER_SELECTOR_MODEL="deepseek-v4-flash"
WEB_ANSWER_MODEL="deepseek-v4-pro"
RESULT_SYNTHESIZER_MODEL="deepseek-v4-pro"

# General-answer web search. "auto" uses the OpenAI-compatible API first when
# OPENAI_BASE_URL points at DeepSeek, then falls back to DuckDuckGo HTML.
WEB_SEARCH_PROVIDER="auto"
WEB_SEARCH_MODEL="deepseek-v4-pro"
WEB_SEARCH_FALLBACK=1
# WEB_SEARCH_CONTEXT_SIZE="medium"

# Deprecated compatibility aliases. These are no longer the recommended primary
# configuration and are only kept for short-term migration support.
# ANTHROPIC_API_KEY="legacy_anthropic_key_here"
# ANTHROPIC_BASE_URL="https://api.claudecode.net.cn/api/claudecode"

# ============================================================================
# Data Paths
# ============================================================================
CACHE_PATH=./data/cache
OUTPUT_PATH=./outputs

# ============================================================================
# API Configuration
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# ============================================================================
# Worker Configuration
# ============================================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ============================================================================
# Database (Optional)
# ============================================================================
DATABASE_URL=postgresql://user:password@localhost/oceanmaster

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE=./logs/oceanmaster.log

# ============================================================================
# Environment
# ============================================================================
ENVIRONMENT=development
DEBUG=true
